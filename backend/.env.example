# Скопируй этот файл в backend/.env и заполни значения.
# Настоящий .env в репозиторий не попадает — он в .gitignore.

# ---------- Сервер ----------
PORT=4000

# Секрет для подписи токенов входа. Любая длинная случайная строка.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Где хранить базу и загруженные чеки. Обе папки игнорируются гитом.
DB_PATH=./data/expense-tracker.db
UPLOAD_DIR=./data/uploads

# ---------- Telegram ----------
# Токен бота от @BotFather. Без него вход через Telegram и сам бот не запустятся.
BOT_TOKEN=

# Имя бота без @ — из него собирается ссылка-приглашение для друзей.
BOT_USERNAME=

# Публичный https-адрес мини-аппа — на него ведёт кнопка в боте.
# Для разработки подойдёт адрес туннеля, например https://smth.trycloudflare.com
MINI_APP_URL=

# Прокси для запросов к Telegram — нужен там, где api.telegram.org
# недоступен напрямую. Например: http://127.0.0.1:10809
BOT_PROXY=

# ---------- Настройки рейтинга ----------
# Сумма, с которой сравниваются траты за месяц. Даёт середину шкалы — 5.00.
AVERAGE_MONTHLY_SPENT=25000

# ---------- Анти-чит ----------
MAX_RECEIPTS_PER_DAY=20
MAX_AMOUNT_PER_DAY=100000
